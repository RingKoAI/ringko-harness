{
  "name": "@ringko-ai/tui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "bin": {
    "ringko": "./src/cli.ts"
  },
  "scripts": {
    "start": "bun src/cli.ts",
    "test": "bun test src",
    "build": "bun scripts/compile.mjs ../../dist/ringko",
    "build:linux-x64": "bun scripts/compile.mjs ../../dist/ringko-linux-x64 bun-linux-x64",
    "build:linux-arm64": "bun scripts/compile.mjs ../../dist/ringko-linux-arm64 bun-linux-arm64",
    "build:macos-x64": "bun scripts/compile.mjs ../../dist/ringko-darwin-x64 bun-darwin-x64",
    "build:macos-arm64": "bun scripts/compile.mjs ../../dist/ringko-darwin-arm64 bun-darwin-arm64",
    "build:windows-x64": "bun scripts/compile.mjs ../../dist/ringko-windows-x64.exe bun-windows-x64",
    "build:all": "pnpm run build:linux-x64 && pnpm run build:linux-arm64 && pnpm run build:macos-x64 && pnpm run build:macos-arm64 && pnpm run build:windows-x64"
  },
  "dependencies": {
    "@ringko-ai/config": "workspace:*",
    "@ringko-ai/providers": "workspace:*",
    "@ringko-ai/sdk": "workspace:*",
    "@ringko-ai/tools": "workspace:*"
  }
}
